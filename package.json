{
  "name": "file-sentinel",
  "version": "2.0.0",
  "description": "File integrity verification, replication, and recovery tool.",
  "author": "Sayem Shafayet <ishafayet@gmail.com>",
  "license": "GPL-3.0",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iShafayet/file-sentinel.git"
  },
  "bugs": {
    "url": "https://github.com/iShafayet/file-sentinel/issues"
  },
  "homepage": "https://github.com/iShafayet/file-sentinel#readme",
  "keywords": [
    "file-integrity",
    "backup",
    "verification",
    "checksum",
    "sha256",
    "data-integrity",
    "corruption-detection",
    "file-recovery",
    "backup-tool",
    "cli"
  ],
  "files": [
    "dist/src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "main": "dist/src/start.js",
  "bin": {
    "file-sentinel": "dist/src/start.js"
  },
  "scripts": {
    "build": "npx tsc && node scripts/post-build.js",
    "prepublishOnly": "npm run build",
    "lint": "eslint .",
    "start": "node dist/src/start.js",
    "start-compiled": "npm run build && npm start",
    "test": "npm run build && node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "install-cli": "npm run build && npm install -g ."
  },
  "dependencies": {
    "better-sqlite3": "^12.5.0",
    "check-disk-space": "^3.3.1",
    "commander": "^13.1.0",
    "dotenv": "^16.4.7",
    "joi": "^17.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jest": "^29.5.14",
    "@types/node": "^17.0.35",
    "@typescript-eslint/eslint-plugin": "^5.26.0",
    "@typescript-eslint/parser": "^5.26.0",
    "concurrently": "^7.2.1",
    "eslint": "^8.16.0",
    "eslint-plugin-jest": "^26.4.6",
    "jest": "^29.7.0",
    "node-fetch": "^3.2.3",
    "nodemon": "^3.1.9",
    "stream-equal": "^2.0.1",
    "typescript": "^4.9.5"
  }
}
